.journey-nav { display: flex; align-items: center; justify-content: space-between; min-height: 72rpx; margin-bottom: 20rpx; border-bottom: 1rpx solid #ded4c1; color: #6a786f; font-size: 23rpx; }
.journey-nav button { width: auto; margin: 0; padding: 0 12rpx 0 0; background: transparent; color: #245947; font-size: 24rpx; line-height: 72rpx; }
.journey-nav button::after { border: 0; }
.current { color: #7d6b50; }
