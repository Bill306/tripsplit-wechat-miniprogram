.invitation-ticket { text-align: center; background: #fffdf5; }
.ticket-caption { color: #687462; font-size: 24rpx; }
.matching-code { padding: 20rpx 0; color: #234d3d; font-family: Georgia, serif; font-size: 76rpx; font-weight: 800; letter-spacing: 10rpx; }
.invitation-ticket .muted { font-size: 24rpx; line-height: 1.7; }
.ticket-actions { display: flex; gap: 12rpx; margin-top: 26rpx; padding-top: 24rpx; border-top: 2rpx dashed #d5c9b3; }
.ticket-actions button { flex: 1; padding: 0 10rpx; font-size: 24rpx; }
.qr-wrap { display: flex; flex-direction: column; align-items: center; margin-top: 28rpx; color: #657567; font-size: 22rpx; }
.qr-wrap image { width: 320rpx; height: 320rpx; margin-bottom: 16rpx; }
.generate-button { margin: 28rpx 0 12rpx; }
.illustration-banner { height: 200rpx; }
.revoke-link { margin-top: 20rpx; background: transparent; color: #876354; font-size: 22rpx; }
