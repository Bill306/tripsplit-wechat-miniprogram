<view wx:if="{{expense}}" class="page-shell">
  <journey-nav label="账单详情"/>
  <view class="eyebrow">{{expense.categoryLabel}}</view><view class="expense-title">{{expense.note || expense.categoryLabel}}</view><view class="expense-amount">{{expense.amountText}}</view>
  <view wx:if="{{expense.originalAmountText}}" class="paper-card detail-card"><view><text>原币金额</text><strong>{{expense.originalAmountText}}</strong></view><view><text>{{expense.fxDescription}}</text></view><view><text>{{expense.fx.source}} {{expense.fx.rateDate ? '· 报价日期 ' + expense.fx.rateDate : ''}}</text></view><view class="muted">汇率已随账单保存，不随行情更新。参考价不代表微信或银行卡实际扣款价。</view></view>
  <view class="paper-card detail-card"><view><text>付款人</text><strong>{{expense.payerName}}</strong></view><view><text>消费日期</text><strong>{{expense.spentAtText}}</strong></view><view><text>分摊方式</text><strong>{{expense.splitMode === 'units' ? '按份数' : '均分'}}</strong></view></view>
  <view class="section-title">每人承担</view><view class="share-list"><view wx:for="{{expense.sharesView}}" wx:key="memberId"><text>{{item.name}}</text><strong>{{item.amountText}}</strong></view></view>
  <view class="revision-note">第 {{expense.revision}} 版 · 重要修改会重新计算结算方案</view>
  <view class="section-title">变更记录</view><view wx:if="{{expense.auditEvents.length}}" class="audit-list"><view wx:for="{{expense.auditEvents}}" wx:key="id" class="audit-row"><view><strong>{{item.summary}}</strong><text>{{item.actorName}}</text></view><text>{{item.createdAtText}}</text></view></view><view wx:else class="muted">暂无变更记录</view>
  <view wx:if="{{expense.canEdit}}" class="fixed-actions"><button class="danger-button" loading="{{deleting}}" bindtap="remove">删除</button><button class="primary-button" bindtap="edit">编辑</button></view>
</view>
<view wx:else class="page-shell"><journey-nav label="账单详情"/><view wx:if="{{loading}}" class="page-loading">正在读取账单…</view><view wx:if="{{error}}" class="demo-banner">{{error}}<button class="quiet-button" bindtap="load">重新加载</button></view></view>
