.settle-head { display: flex; align-items: flex-start; gap: 20rpx; }
.settle-head .page-title { flex: 1; }
.settle-head .status-chip { margin-top: 16rpx; white-space: nowrap; }
.settle-banner { height: 238rpx; }
.balance-list { overflow: hidden; background: #fffaf0; border: 2rpx solid #d8cdbb; border-radius: 28rpx 28rpx 10rpx 28rpx; box-shadow: 0 14rpx 32rpx rgba(41,52,46,.06); }
.balance-row { display: flex; align-items: center; min-height: 94rpx; padding: 18rpx 22rpx; border-bottom: 2rpx solid #eee9df; }
.balance-row:last-child { border-bottom: 0; }
.member-avatar { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-right: 16rpx; background: #f8e8b8; border: 2rpx solid #d9b65e; border-radius: 50%; color: #315a4f; font-weight: 900; box-shadow: 0 4rpx 0 #e07156; }
.balance-name { flex: 1; }
.transfer-card { text-align: center; }
.transfer-route { display: flex; align-items: center; justify-content: center; gap: 22rpx; font-size: 30rpx; }
.transfer-route text { color: #f26b4b; font-size: 42rpx; }
.transfer-amount { margin-top: 18rpx; font-size: 48rpx; font-weight: 900; }
.transfer-status { margin: 8rpx 0 22rpx; color: #6e7c75; font-size: 24rpx; }
.mini-button { min-height: 76rpx; font-size: 26rpx; line-height: 76rpx; }
.transfer-actions { display: flex; gap: 12rpx; }
.transfer-actions button { flex: 1; }
