<view wx:if="{{trip}}" class="page-shell">
  <journey-nav label="同行伙伴"/>
  <view class="page-title">同行伙伴</view><view class="page-subtitle">{{trip.name}} · 大家各记一笔，共享同一本账。</view>
  <view wx:if="{{trip.canManage && trip.status !== 'archived'}}" class="journey-note"><text class="note-title">让朋友用自己的微信加入</text><button class="quiet-button" bindtap="openInvite">邀请微信好友 ›</button></view>
  <view wx:if="{{trip.canManage}}" class="section-title">帮不使用小程序的旅伴记账</view>
  <view class="page-subtitle">手动添加的是离线成员，不是微信账号。对方不会自动收到邀请，也不能登录这个成员身份确认收款。</view>
  <view wx:if="{{trip.canManage}}" class="paper-card add-card"><input class="member-input" maxlength="30" placeholder="输入成员名字" value="{{newName}}" bindinput="updateNewName"/><button class="primary-button add-button" loading="{{busy}}" disabled="{{busy}}" bindtap="add">添加</button></view>
  <view class="section-title">成员列表 · {{trip.members.length}}</view>
  <view class="member-list">
    <view wx:for="{{trip.members}}" wx:key="id" class="member-row {{item.status === 'inactive' ? 'inactive' : ''}}">
      <button wx:if="{{item.isCurrent && item.status === 'active' && trip.status !== 'archived'}}" class="avatar avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{busy}}"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/><text wx:else>{{item.initial}}</text><view class="avatar-edit">✎</view></button>
      <view wx:else class="avatar"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/><text wx:else>{{item.initial}}</text></view>
      <view wx:if="{{editingId === item.id}}" class="rename-box"><input value="{{editingName}}" bindinput="updateEditingName"/><button bindtap="saveRename">保存</button><button bindtap="cancelRename">取消</button></view>
      <block wx:else><view class="member-main"><strong>{{item.displayName}}</strong><text>{{item.role === 'owner' ? '创建者' : (item.userId ? '微信成员' : '离线成员')}} · {{item.status === 'active' ? '活跃' : '已停用'}}<text wx:if="{{item.isCurrent && item.status === 'active' && trip.status !== 'archived'}}"> · 点击头像可更换</text></text></view><view wx:if="{{trip.canManage && item.role !== 'owner' && item.status === 'active'}}" class="member-actions"><button wx:if="{{item.userId === null}}" data-id="{{item.id}}" data-name="{{item.displayName}}" bindtap="startRename">改名</button><button wx:if="{{item.userId}}" data-id="{{item.id}}" data-name="{{item.displayName}}" bindtap="transferOwner">转让</button><button data-id="{{item.id}}" bindtap="remove">移除</button><button data-id="{{item.id}}" bindtap="deactivate">停用</button></view></block>
    </view>
  </view>
</view>
<view wx:else class="page-shell"><journey-nav label="同行伙伴"/><view wx:if="{{loading}}" class="page-loading">正在寻找同行伙伴…</view><view wx:if="{{error}}" class="demo-banner">{{error}}<button class="quiet-button" bindtap="load">重新加载</button></view></view>
