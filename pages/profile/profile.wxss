@import "../../styles/sketch.wxss";
.profile-shell { padding: 18rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); }
.login-brand { padding: 22rpx 8rpx 0; }
.brand-lockup { display: flex; align-items: center; gap: 14rpx; }
.brand-name { font-size: 60rpx; line-height: 1.3; }
.brand-slogan { margin-top: 12rpx; font-size: 26rpx; line-height: 1.6; letter-spacing: 1rpx; color: #395545; }
.login-cat { display: block; width: 100vw; height: 360rpx; margin: -2rpx -32rpx -14rpx; }
.login-card { position: relative; padding: 30rpx 32rpx 28rpx; }
.paper-tape { position: absolute; top: -12rpx; left: 34rpx; width: 74rpx; height: 26rpx; border-left: 3rpx solid rgba(197,151,57,.16); border-right: 3rpx solid rgba(197,151,57,.16); background: rgba(240,208,139,.47); transform: rotate(-24deg); }
.login-heading { margin-bottom: 16rpx; font-size: 34rpx; text-align: center; }
button.avatar-picker { display: flex; flex-direction: column; align-items: center; width: 100%; margin: 0; padding: 4rpx 0 18rpx; background: transparent; color: #294637; line-height: 1.4; }
.avatar-wrap { position: relative; flex: none; width: 116rpx; height: 116rpx; }
.avatar-wrap image, .avatar-placeholder { width: 116rpx; height: 116rpx; border: 5rpx solid #fffdf7; border-radius: 50%; box-shadow: 0 0 0 2rpx #e4d1ab, 0 5rpx 12rpx rgba(90,64,26,.1); }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; background: #eedbb6; color: #6e8164; }
.avatar-placeholder .paw-icon { width: 58rpx; height: 58rpx; }
.camera-mark { position: absolute; right: -6rpx; bottom: -2rpx; display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; background: #2e7558; border: 3rpx solid #fffdf7; border-radius: 50%; color: #fff9eb; font-size: 26rpx; }
.avatar-copy { margin-top: 14rpx; text-align: center; }
.avatar-copy text { display: block; color: #758071; font-size: 21rpx; }
.avatar-copy .avatar-title { margin-bottom: 5rpx; color: #294637; font-size: 28rpx; font-weight: 600; }
.nickname-field { margin-top: 8rpx; }
.field-label { display: block; margin-bottom: 10rpx; color: #667261; font-size: 23rpx; }
.nickname-input { width: 100%; height: 92rpx; padding: 0 24rpx; background: #faf7ef; border: 2rpx solid #cfcbb9; border-radius: 22rpx 18rpx 24rpx 20rpx; color: #203f34; font-size: 29rpx; }
.wechat-account-state { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 18rpx; color: #59775b; font-size: 22rpx; }
.state-icon { font-weight: 700; }
button.wechat-login-button { width: 100%; margin-top: 26rpx; font-size: 29rpx; }
.privacy-note { margin-top: 24rpx; color: #788073; font-size: 21rpx; line-height: 1.7; text-align: center; }
.login-footnote { margin-top: 26rpx; color: #7f886e; font-size: 22rpx; line-height: 1.5; text-align: center; }
@media (max-width: 350px) { .brand-name { font-size: 56rpx; } .wechat-login-button { font-size: 27rpx; gap: 12rpx; padding-right: 16rpx; padding-left: 16rpx; } }
