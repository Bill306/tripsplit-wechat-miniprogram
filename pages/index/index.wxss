.home-shell { padding-top: 54rpx; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-bottom: 28rpx; background: #17362e; border-radius: 20rpx 20rpx 20rpx 4rpx; color: #fffdf8; font-size: 26rpx; font-weight: 900; }
.trip-list { margin-top: 42rpx; }
.trip-card { position: relative; overflow: hidden; }
.trip-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 10rpx; background: #f26b4b; }
.trip-card-head, .trip-metrics { display: flex; align-items: flex-start; justify-content: space-between; }
.trip-name { max-width: 390rpx; font-size: 34rpx; font-weight: 800; }
.trip-meta { margin-top: 10rpx; color: #6e7c75; font-size: 24rpx; }
.ticket-line { margin: 26rpx 0; border-top: 2rpx dashed #d8d2c4; }
.trip-metrics > view { display: flex; flex-direction: column; }
.metric-right { text-align: right; }
.metric-label { color: #6e7c75; font-size: 22rpx; }
.metric-value { margin-top: 8rpx; font-size: 30rpx; font-weight: 800; }
.empty-icon { font-size: 64rpx; }
.empty-title { margin: 18rpx 0 10rpx; font-size: 32rpx; font-weight: 800; }
