<view class="page-shell home-shell">
  <view class="brand-mark">TS</view>
  <view class="eyebrow">TRAVEL LEDGER</view>
  <view class="page-title">旅行中随手记，<br/>结束时不用算。</view>
  <view class="page-subtitle">和朋友共享一本账，谁垫付、谁应付，一眼看清。</view>
  <view wx:if="{{mode === 'demo'}}" class="demo-banner">当前为本机演示模式；界面与计算可用，但多人共享需完成云开发配置。</view>
  <view wx:if="{{error}}" class="demo-banner">{{error}}</view>
  <view wx:if="{{trips.length}}" class="trip-list">
    <view wx:for="{{groups}}" wx:key="key" wx:for-item="group" class="trip-group">
      <view class="group-title">{{group.title}} <text>{{group.trips.length}}</text></view>
    <view wx:for="{{group.trips}}" wx:key="id" wx:for-item="trip" class="paper-card trip-card" data-id="{{trip.id}}" bindtap="openTrip">
      <view class="trip-card-head">
        <view><view class="trip-name">{{trip.name}}</view><view class="trip-meta">{{trip.destination || '还没填目的地'}} · {{trip.members.length}} 人</view></view>
        <view class="status-chip">{{trip.statusLabel}}</view>
      </view>
      <view class="ticket-line"></view>
      <view class="trip-metrics">
        <view><text class="metric-label">总消费</text><text class="metric-value">{{trip.totalAmount}}</text></view>
        <view class="metric-right"><text class="metric-label">{{trip.myNetLabel}}</text><text class="metric-value {{trip.myNetClass}}">{{trip.myNetAmount}}</text></view>
      </view>
    </view>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="empty-state">
    <view class="empty-icon">🧭</view><view class="empty-title">先建立第一次旅行</view><view class="muted">把同行伙伴和每笔费用放在一起。</view>
  </view>
  <view class="fixed-actions"><button class="primary-button" bindtap="createTrip">+  创建新行程</button></view>
</view>
