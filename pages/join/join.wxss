.join-banner { height: 340rpx; margin-top: 32rpx; }
.avatar-select { display: flex; align-items: center; gap: 18rpx; min-height: 104rpx; margin: 0; padding: 12rpx 20rpx; background: #fffaf0; border: 2rpx solid #d8cbb4; border-radius: 20rpx; color: #315a4f; font-size: 25rpx; font-weight: 800; line-height: 1.2; }
.avatar-select image, .avatar-select > text { width: 76rpx; height: 76rpx; border-radius: 50%; }
.avatar-select > text { display: flex; align-items: center; justify-content: center; background: #f8e7b3; font-size: 40rpx; }
